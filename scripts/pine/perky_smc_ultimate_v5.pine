DASHED       = '----'
DOTTED       = '····'
UI_GROUP       = '◆ Appearance'
SCORE_GROUP    = '◆ Signal Quality'
SMART_GROUP    = 'Smart Money Concepts'
INTERNAL_GROUP = 'Real Time Internal Structure'
SWING_GROUP    = 'Real Time Swing Structure'
BLOCKS_GROUP   = 'Order Blocks'
EQUAL_GROUP    = 'EQH/EQL'
GAPS_GROUP     = 'Fair Value Gaps'
LEVELS_GROUP   = 'Highs & Lows MTF'
ZONES_GROUP    = 'Premium & Discount Zones'
SWEEPS_GROUP   = 'Liquidity Sweeps'
ENTRY_GROUP    = 'Entry & Exit Strategy'
EMA_RSI_GROUP  = '📈 EMA / RSI'
DASH_GROUP     = 'MTF Dashboard'

//---------------------------------------------------------------------------------------------------------------------}
// INPUTS — APPEARANCE
//---------------------------------------------------------------------------------------------------------------------{
densityInput   = input.string('Minimal', 'Chart Density', group=UI_GROUP, options=['Minimal','Balanced','Full'], tooltip='Minimal hides decorative text (FVG tags, sweep tags, swing-point labels) and forces compact label sizes. Signals are never hidden — only chrome.')
entryCardInput = input.string('Micro',   'Signal Card',   group=UI_GROUP, options=['Micro','Compact','Full'])
watermarkInput = input.string('Modern',  'Watermark',     group=UI_GROUP, options=['Modern','Serif','Off'])
accentInput    = input.color(GOLD,       'Accent',        group=UI_GROUP, inline='surf')
surfaceInput   = input.color(NAVY,       'Surface',       group=UI_GROUP, inline='surf')

dnsMin  = densityInput == 'Minimal'
dnsFull = densityInput == 'Full'
ACCENT  = accentInput
SURFACE = surfaceInput

labelOffsetInput  = input.float(1.0, 'Label Distance',                 group=UI_GROUP, minval=0.1, maxval=6.0, step=0.1, tooltip='Measured in units of 10% of the last 100 bars\' range, so cards clear the candles by the same visual amount on any symbol or timeframe. 1.0 ≈ one tenth of the visible range.')
crossOffsetInput  = input.float(1.5, 'Cross Label Distance',           group=UI_GROUP, minval=0.1, maxval=8.0, step=0.1)
crossMinBarsInput = input.int(20,    'Min Bars Between Cross Labels',  group=UI_GROUP, minval=0, maxval=300, tooltip='EMA crosses cluster in chop and stack their labels on top of each other. This suppresses repeats inside the window — the alerts still fire.')
edgeOffsetInput   = input.int(5,     'Right-Edge Label Offset (bars)', group=UI_GROUP, minval=1, maxval=40, tooltip='Pushes Strong/Weak High-Low and MTF level tags closer to the last candle so they stop colliding with the dashboard.')

uiSize(string s) => dnsMin ? size.tiny : s

