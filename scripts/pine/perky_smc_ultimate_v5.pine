//@version=6
indicator('Perky SMC Ultimate V5', 'PerkySMCV5', overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

//---------------------------------------------------------------------------------------------------------------------}
// CONSTANTS
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_LEG  = 1
BEARISH_LEG  = 0
BULLISH      = +1
BEARISH      = -1
// ── OBSIDIAN PALETTE ────────────────────────────────────────────────
GOLD         = #D8B25F      // champagne accent — brand
GOLD_DIM     = #7A6430      // hairline gold
SILVER       = #9AA3B2      // cool graphite
TEAL         = #2FC79A      // bull — jade
ROSE         = #E4596E      // bear — garnet
NAVY         = #080A10      // card ground
DARK_GRAY    = #10131B      // surface
GRAY         = #2A3040      // hairline
LIGHT_GRAY   = #8B95A7      // secondary text
TEXT_HI      = #D7DDE8      // primary text
MONO_BULLISH = #E6EAF2      // monochrome bull — bone
MONO_BEARISH = #6B7280      // monochrome bear — graphite
GREEN        = #2FC79A
RED          = #E4596E
BLUE         = #4C7DF0
HAIR         = '──────────────'
HISTORICAL   = 'Historical'
PRESENT      = 'Present'
COLORED      = 'Colored'
MONOCHROME   = 'Monochrome'
ALL          = 'All'
BOS          = 'BOS'
CHOCH        = 'CHoCH'
TINY         = size.tiny
SMALL        = size.small
NORMAL       = size.normal
ATR          = 'Atr'
RANGE        = 'Cumulative Mean Range'
CLOSE        = 'Close'
HIGHLOW      = 'High/Low'
